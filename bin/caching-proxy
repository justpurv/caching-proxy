#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TARGET_DIR="$PROJECT_ROOT/target"

if [[ ! -d "$TARGET_DIR/lib" || ! -d "$TARGET_DIR/classes" ]]; then
  echo "Build artifacts not found. Run: mvn clean package" >&2
  exit 1
fi

exec java -cp "$TARGET_DIR/classes:$TARGET_DIR/lib/*" org.project.CachingApplication "$@"
