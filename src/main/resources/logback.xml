<configuration>

    <!-- Logs directory -->
    <property name="LOG_PATH" value="logs"/>
    <property name="APP_NAME" value="my-app"/>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%-5level thread=%thread logger=%logger{36} msg="%msg" %kvp%n
            </pattern>
        </encoder>
    </appender>

    <!-- Rolling File Appender -->
    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <!-- Current active log file -->
        <file>${LOG_PATH}/${APP_NAME}.log</file>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%-5level thread=%thread logger=%logger{36} msg="%msg" %kvp%n
            </pattern>
        </encoder>

        <!-- Daily rolling policy -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

            <!-- Archive old logs -->
            <fileNamePattern>
                ${LOG_PATH}/archive/${APP_NAME}.%d{yyyy-MM-dd}.log
            </fileNamePattern>

            <!-- Keep 30 days of logs -->
            <maxHistory>30</maxHistory>

            <!-- Optional total size cap -->
            <totalSizeCap>2GB</totalSizeCap>

        </rollingPolicy>
    </appender>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
